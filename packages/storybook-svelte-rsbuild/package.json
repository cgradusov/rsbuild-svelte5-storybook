{
  "name": "storybook-svelte-rsbuild",
  "version": "0.3.0",
  "description": "Storybook framework for Svelte 5 powered by Rsbuild",
  "keywords": [
    "storybook",
    "svelte",
    "svelte5",
    "rsbuild",
    "rspack",
    "framework",
    "storybook-framework"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgradusov/rsbuild-svelte5-storybook.git",
    "directory": "packages/storybook-svelte-rsbuild"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "preset.js",
    "preview.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@storybook/addon-svelte-csf": "^5.1.0",
    "@storybook/svelte": "^10.0.0",
    "acorn": "^8.12.0",
    "magic-string": "^0.30.0",
    "storybook-builder-rsbuild": "^3.3.3",
    "svelte-ast-print": "^0.4.0",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.1.0",
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "storybook": "^10.0.0",
    "svelte": "^5.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0",
    "storybook": "^10.0.0",
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
